{
  "name": "temple-of-eka-danta",
  "version": "1.2.0",
  "description": "The Temple of Eka-Danta — a mission-based mythological adventure in the browser: eight tasks against the asuras of the Vinayaka Purana. TypeScript, Three.js, Rapier.",
  "keywords": [
    "game",
    "three.js",
    "rapier",
    "typescript",
    "vite",
    "pwa",
    "mythology",
    "ganesha"
  ],
  "author": "Rithish <shathwik@icloud.com>",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "assets": "node tools/bake-assets.mjs",
    "mobile:android": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease && cd .. && mkdir -p dist && cp android/app/build/outputs/bundle/release/app-release.aab dist/",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "screenshots": "node tools/screenshots.mjs",
    "play:missions": "node tools/play-missions.mjs test-results/missions http://127.0.0.1:5173 8",
    "voice": "node tools/gen-voice.mjs",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
